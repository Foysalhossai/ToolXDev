---
import ToolLayout from '../../layouts/ToolLayout.astro';

const toolData = {
  name: 'JSON Formatter & Validator',
  title: 'JSON Formatter & Validator — Beautify & Validate JSON Online',
  description: 'Format, validate, beautify, and minify JSON strings instantly in your browser. Features real-time error detection with detailed syntax messages.',
  category: 'Developer Tools',
  categoryHref: '/tools#developer',
  privacyNotice: 'Your JSON code is processed locally in your browser memory. No payload is ever sent to any external server or saved in cookies.',
  howToUse: [
    { step: 'Paste JSON', text: 'Paste your raw or minified JSON text into the editor below.' },
    { step: 'Format or Minify', text: 'Click "Beautify (2 Spaces)", "Beautify (4 Spaces)", or "Minify" to transform your structure.' },
    { step: 'Inspect Validation', text: 'If your JSON contains syntax errors, a descriptive error badge will indicate the issue.' },
    { step: 'Copy Result', text: 'Use the Copy button to immediately place the formatted code into your clipboard.' },
  ],
  features: [
    'Strict JSON.parse validation matching RFC 8259 specifications',
    'Custom indentation options (2 spaces, 4 spaces)',
    'Fast one-click minification to remove extra whitespace and newlines',
    'Clear visual indication of valid vs invalid JSON state',
    'Large payload handling up to browser memory limits',
  ],
  limitations: [
    'Does not execute JavaScript objects (strictly standard JSON with double-quoted keys)',
    'Comments are not part of standard JSON specification and will be flagged as syntax errors',
  ],
  faqs: [
    {
      q: 'Why does valid JavaScript object syntax fail validation here?',
      a: 'JSON (JavaScript Object Notation) is a strict data interchange format requiring double quotes around keys and strings, and forbids trailing commas or unquoted keys.',
    },
    {
      q: 'Can this tool handle sensitive production API responses?',
      a: 'Yes, absolutely. Because the formatting runs 100% locally in your client environment, no network traffic is generated.',
    },
  ],
};
---

<ToolLayout {...toolData}>
  <div class="space-y-4">
    {/* Control Bar */}
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
      <div class="flex flex-wrap items-center gap-2">
        <button
          id="btn-format-2"
          type="button"
          class="rounded-lg bg-blue-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 cursor-pointer transition-colors"
        >
          Beautify (2 Spaces)
        </button>
        <button
          id="btn-format-4"
          type="button"
          class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-colors"
        >
          Beautify (4 Spaces)
        </button>
        <button
          id="btn-minify"
          type="button"
          class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-colors"
        >
          Minify / Compact
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-sample"
          type="button"
          class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 cursor-pointer"
        >
          Sample
        </button>
        <button
          id="btn-copy"
          type="button"
          class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 cursor-pointer"
        >
          Copy
        </button>
        <button
          id="btn-clear"
          type="button"
          class="rounded-lg border border-red-200 bg-red-50 px-3 py-1.5 text-xs font-medium text-red-700 hover:bg-red-100 cursor-pointer"
        >
          Clear
        </button>
      </div>
    </div>

    {/* Validation Status Indicator */}
    <div id="status-bar" class="hidden rounded-lg p-3 text-xs font-medium"></div>

    {/* JSON Editor Textarea */}
    <div class="relative">
      <textarea
        id="json-input"
        rows="16"
        placeholder='Paste raw JSON here, e.g. {"name": "ToolXDev", "active": true}'
        class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
        spellcheck="false"
      ></textarea>
    </div>

    {/* Footer Metrics */}
    <div class="flex items-center justify-between text-xs text-slate-500 pt-1">
      <div id="size-stats">0 bytes • 0 lines</div>
      <div class="font-mono">RFC 8259 Standard</div>
    </div>
  </div>

  <script>
    const jsonInput = document.getElementById('json-input') as HTMLTextAreaElement | null;
    const statusBar = document.getElementById('status-bar');
    const sizeStats = document.getElementById('size-stats');

    const btnFormat2 = document.getElementById('btn-format-2');
    const btnFormat4 = document.getElementById('btn-format-4');
    const btnMinify = document.getElementById('btn-minify');
    const btnSample = document.getElementById('btn-sample');
    const btnCopy = document.getElementById('btn-copy');
    const btnClear = document.getElementById('btn-clear');

    function updateSize() {
      if (!jsonInput || !sizeStats) return;
      const text = jsonInput.value;
      const bytes = new Blob([text]).size;
      const lines = text ? text.split('\n').length : 0;
      sizeStats.textContent = `${bytes.toLocaleString()} bytes • ${lines.toLocaleString()} lines`;
    }

    function showStatus(isValid: boolean, message: string) {
      if (!statusBar) return;
      statusBar.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-rose-50', 'text-rose-800', 'border-rose-200');
      statusBar.classList.add('border');

      if (isValid) {
        statusBar.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
        statusBar.textContent = message;
      } else {
        statusBar.classList.add('bg-rose-50', 'text-rose-800', 'border-rose-200');
        statusBar.textContent = message;
      }
    }

    function hideStatus() {
      if (statusBar) statusBar.classList.add('hidden');
    }

    function formatJSON(indent: number) {
      if (!jsonInput) return;
      const val = jsonInput.value.trim();
      if (!val) {
        hideStatus();
        return;
      }

      try {
        const parsed = JSON.parse(val);
        jsonInput.value = JSON.stringify(parsed, null, indent);
        showStatus(true, `Valid JSON — Successfully formatted with ${indent} space indentation.`);
        updateSize();
      } catch (err: any) {
        showStatus(false, `Invalid JSON Syntax: ${err?.message || 'Parse Error'}`);
      }
    }

    function minifyJSON() {
      if (!jsonInput) return;
      const val = jsonInput.value.trim();
      if (!val) {
        hideStatus();
        return;
      }

      try {
        const parsed = JSON.parse(val);
        jsonInput.value = JSON.stringify(parsed);
        showStatus(true, 'Valid JSON — Successfully minified to a compact single-line string.');
        updateSize();
      } catch (err: any) {
        showStatus(false, `Invalid JSON Syntax: ${err?.message || 'Parse Error'}`);
      }
    }

    btnFormat2?.addEventListener('click', () => formatJSON(2));
    btnFormat4?.addEventListener('click', () => formatJSON(4));
    btnMinify?.addEventListener('click', minifyJSON);

    jsonInput?.addEventListener('input', () => {
      updateSize();
      const val = jsonInput.value.trim();
      if (!val) {
        hideStatus();
        return;
      }
      try {
        JSON.parse(val);
        showStatus(true, 'Valid JSON syntax.');
      } catch (err: any) {
        showStatus(false, `Syntax Warning: ${err?.message}`);
      }
    });

    btnSample?.addEventListener('click', () => {
      if (!jsonInput) return;
      const sample = {
        project: "ToolXDev",
        domain: "toolxdev.org",
        features: ["zero-config", "privacy-first", "client-side"],
        tools: [
          { id: 1, name: "Word Counter", status: "active" },
          { id: 2, name: "JSON Formatter", status: "active" },
          { id: 3, name: "Image Compressor", status: "active" }
        ],
        settings: {
          offlineCapable: true,
          theme: "light"
        }
      };
      jsonInput.value = JSON.stringify(sample, null, 2);
      showStatus(true, 'Valid sample JSON loaded.');
      updateSize();
    });

    btnCopy?.addEventListener('click', async () => {
      if (!jsonInput || !jsonInput.value) return;
      await navigator.clipboard.writeText(jsonInput.value);
      const originalText = btnCopy.textContent;
      btnCopy.textContent = 'Copied!';
      setTimeout(() => {
        btnCopy.textContent = originalText;
      }, 1500);
    });

    btnClear?.addEventListener('click', () => {
      if (!jsonInput) return;
      jsonInput.value = '';
      hideStatus();
      updateSize();
    });
  </script>
</ToolLayout>
