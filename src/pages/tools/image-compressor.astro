---
import ToolLayout from '../../layouts/ToolLayout.astro';

const toolData = {
  name: 'Client-Side Image Compressor',
  title: 'Image Compressor — Compress JPG, PNG & WebP Images Online',
  description: 'Reduce image file size without losing noticeable quality. Runs 100% locally in your browser using HTML5 Canvas with instant download and zero server uploads.',
  category: 'Image & Media',
  categoryHref: '/tools#image',
  privacyNotice: 'Your pictures never leave your computer. All rendering, compression, and encoding happen directly inside your browser memory.',
  howToUse: [
    { step: 'Select Image', text: 'Drag and drop or browse to select a JPEG, PNG, or WebP image (up to 20MB).' },
    { step: 'Adjust Quality', text: 'Use the quality slider and optional max width resize settings to achieve your target file size.' },
    { step: 'Compare & Download', text: 'Review the instant reduction metrics and click "Download Compressed Image".' },
  ],
  features: [
    'Lossy and visually lossless compression options',
    'Supports JPEG, PNG, and WebP output formats',
    'Automatic dimension scaling to avoid bloated resolutions',
    'Real-time before-and-after file size and savings percentage',
    'No image upload latency — instantaneous processing',
  ],
  limitations: [
    'Files larger than 25MB or images over 8000x8000 pixels are blocked to preserve browser memory',
    'Animated GIFs and SVG vectors are not supported by canvas compression',
  ],
  faqs: [
    {
      q: 'Will my confidential photos be stored on ToolXDev?',
      a: 'Never. No images are uploaded to any server. The file is read via the browser FileReader API and encoded on an off-screen HTML5 Canvas.',
    },
    {
      q: 'What is the recommended quality setting for websites?',
      a: 'A quality level between 75% and 85% typically reduces file size by 60–80% with virtually imperceptible visual difference.',
    },
  ],
};
---

<ToolLayout {...toolData}>
  <div class="space-y-6">
    {/* Upload Drop Zone */}
    <div
      id="drop-zone"
      class="group relative flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 p-8 text-center transition hover:border-blue-500 bg-slate-50/50 cursor-pointer"
    >
      <input
        id="file-input"
        type="file"
        accept="image/jpeg,image/png,image/webp"
        class="absolute inset-0 h-full w-full opacity-0 cursor-pointer"
      />
      
      <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-50 text-blue-600 mb-3 group-hover:scale-105 transition-transform">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
      </div>

      <p class="text-sm font-semibold text-slate-800">
        Click to choose an image <span class="font-normal text-slate-500">or drag and drop here</span>
      </p>
      <p class="mt-1 text-xs text-slate-400">JPEG, PNG, or WebP up to 20MB</p>
    </div>

    {/* Options & Configuration (visible when image loaded) */}
    <div id="controls-panel" class="hidden space-y-6 rounded-xl border border-slate-200 bg-slate-50/50 p-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {/* Quality Slider */}
        <div class="space-y-2">
          <div class="flex justify-between text-xs font-semibold text-slate-700">
            <span>Compression Quality</span>
            <span id="quality-val" class="font-bold text-blue-600">80%</span>
          </div>
          <input
            id="quality-slider"
            type="range"
            min="10"
            max="100"
            value="80"
            class="w-full accent-blue-600 cursor-pointer"
          />
        </div>

        {/* Output Format */}
        <div class="space-y-2">
          <label for="format-select" class="block text-xs font-semibold text-slate-700">Output Format</label>
          <select
            id="format-select"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none"
          >
            <option value="image/jpeg">JPEG (Universal)</option>
            <option value="image/webp" selected>WebP (Modern & Smallest)</option>
            <option value="image/png">PNG</option>
          </select>
        </div>

        {/* Max Width Resize */}
        <div class="space-y-2">
          <label for="resize-select" class="block text-xs font-semibold text-slate-700">Max Dimension</label>
          <select
            id="resize-select"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-800 focus:border-blue-500 focus:outline-none"
          >
            <option value="0">Original Resolution</option>
            <option value="1920">Full HD (1920px max)</option>
            <option value="1280">Standard (1280px max)</option>
            <option value="800">Thumbnail (800px max)</option>
          </select>
        </div>
      </div>

      {/* Comparison Metrics */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-200 pt-5">
        <div class="rounded-lg bg-white p-3 border border-slate-200">
          <div class="text-xs text-slate-500">Original Size</div>
          <div id="stat-original-size" class="text-lg font-bold text-slate-800 mt-0.5">0 KB</div>
        </div>

        <div class="rounded-lg bg-white p-3 border border-slate-200">
          <div class="text-xs text-slate-500">Compressed Size</div>
          <div id="stat-compressed-size" class="text-lg font-bold text-blue-600 mt-0.5">Calculating...</div>
        </div>

        <div class="rounded-lg bg-emerald-50 p-3 border border-emerald-200">
          <div class="text-xs text-emerald-700 font-medium">Estimated Savings</div>
          <div id="stat-savings" class="text-lg font-bold text-emerald-800 mt-0.5">0%</div>
        </div>
      </div>

      {/* Download Action */}
      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          id="btn-download"
          type="button"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 cursor-pointer transition-colors"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Compressed Image</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    const fileInput = document.getElementById('file-input') as HTMLInputElement | null;
    const controlsPanel = document.getElementById('controls-panel');
    const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
    const qualityVal = document.getElementById('quality-val');
    const formatSelect = document.getElementById('format-select') as HTMLSelectElement | null;
    const resizeSelect = document.getElementById('resize-select') as HTMLSelectElement | null;

    const statOriginal = document.getElementById('stat-original-size');
    const statCompressed = document.getElementById('stat-compressed-size');
    const statSavings = document.getElementById('stat-savings');
    const btnDownload = document.getElementById('btn-download');

    let currentFile: File | null = null;
    let originalImage: HTMLImageElement | null = null;
    let compressedBlobUrl: string | null = null;

    function formatBytes(bytes: number) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const sizes = ['Bytes', 'KB', 'MB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    async function compressImage() {
      if (!originalImage || !currentFile) return;

      if (statCompressed) statCompressed.textContent = 'Processing...';

      const quality = Number(qualitySlider?.value || 80) / 100;
      const mimeType = formatSelect?.value || 'image/webp';
      const maxDim = Number(resizeSelect?.value || 0);

      let width = originalImage.naturalWidth;
      let height = originalImage.naturalHeight;

      if (maxDim > 0 && (width > maxDim || height > maxDim)) {
        if (width > height) {
          height = Math.round((height * maxDim) / width);
          width = maxDim;
        } else {
          width = Math.round((width * maxDim) / height);
          height = maxDim;
        }
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      ctx.drawImage(originalImage, 0, 0, width, height);

      canvas.toBlob(
        (blob) => {
          if (!blob) return;
          if (compressedBlobUrl) URL.revokeObjectURL(compressedBlobUrl);
          compressedBlobUrl = URL.createObjectURL(blob);

          const origSize = currentFile?.size || 1;
          const compSize = blob.size;
          const diff = origSize - compSize;
          const pct = Math.max(0, Math.round((diff / origSize) * 100));

          if (statCompressed) statCompressed.textContent = formatBytes(compSize);
          if (statSavings) statSavings.textContent = `${pct}% smaller`;
        },
        mimeType,
        quality
      );
    }

    fileInput?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (!file) return;

      if (file.size > 25 * 1024 * 1024) {
        alert('File size exceeds the 25MB limit.');
        return;
      }

      currentFile = file;
      if (statOriginal) statOriginal.textContent = formatBytes(file.size);

      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          originalImage = img;
          controlsPanel?.classList.remove('hidden');
          compressImage();
        };
        img.src = event.target?.result as string;
      };
      reader.readAsDataURL(file);
    });

    qualitySlider?.addEventListener('input', () => {
      if (qualityVal && qualitySlider) {
        qualityVal.textContent = `${qualitySlider.value}%`;
      }
      compressImage();
    });

    formatSelect?.addEventListener('change', compressImage);
    resizeSelect?.addEventListener('change', compressImage);

    btnDownload?.addEventListener('click', () => {
      if (!compressedBlobUrl || !currentFile) return;
      const link = document.createElement('a');
      const ext = formatSelect?.value === 'image/jpeg' ? 'jpg' : (formatSelect?.value === 'image/png' ? 'png' : 'webp');
      const baseName = currentFile.name.substring(0, currentFile.name.lastIndexOf('.')) || 'image';
      link.download = `${baseName}-compressed.${ext}`;
      link.href = compressedBlobUrl;
      link.click();
    });
  </script>
</ToolLayout>
