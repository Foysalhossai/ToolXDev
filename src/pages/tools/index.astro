---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools', ({ data }) => data.status === 'published');

const categories = [
  { id: 'developer', name: 'Developer Tools' },
  { id: 'text', name: 'Text & Content Utilities' },
  { id: 'image', name: 'Image & Media' },
];
---

<BaseLayout
  title="All Developer & Web Utilities — ToolXDev"
  description="Explore the complete collection of free online tools on ToolXDev. Format JSON, analyze text, compress images, and generate hashes with zero server uploads."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Tool Directory</h1>
      <p class="mt-3 text-base text-slate-600">
        Browse our complete collection of lightweight, client-side digital utilities. Every tool is designed to work offline once loaded and maintain strict privacy.
      </p>
    </div>

    {categories.map((cat) => {
      const toolsInCat = allTools.filter(t => t.data.categoryId === cat.id);
      if (toolsInCat.length === 0) return null;

      return (
        <div id={cat.id} class="mb-14 scroll-mt-20">
          <div class="flex items-center gap-3 border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-xl font-bold text-slate-900">{cat.name}</h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">
              {toolsInCat.length} {toolsInCat.length === 1 ? 'Tool' : 'Tools'}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {toolsInCat.map((tool) => {
              const slug = tool.id.replace(/\.(json|md)$/, '');
              return (
                <a
                  href={`/tools/${slug}`}
                  class="tool-card group rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 cursor-pointer flex flex-col justify-between"
                >
                  <div>
                    <div class="flex justify-between items-center mb-3">
                      <span class="text-xs font-medium text-slate-500">{tool.data.category}</span>
                      <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-100">
                        {tool.data.executionMode === 'client' ? '100% Private' : 'Fast Edge'}
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                      {tool.data.name}
                    </h3>
                    <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                      {tool.data.shortDescription}
                    </p>
                  </div>
                  <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-blue-600">
                    <span>Open Tool</span>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</BaseLayout>
