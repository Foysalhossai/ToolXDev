---
import BaseLayout from '../../layouts/BaseLayout.astro';

const allTools = [
  {
    name: 'Word Counter & Text Analyzer',
    slug: 'word-counter',
    category: 'Text & Content',
    categoryId: 'text',
    description: 'Instant word, character, sentence, and reading duration statistics in real-time.',
    badge: 'Fast & Offline',
    href: '/tools/word-counter',
  },
  {
    name: 'JSON Formatter & Validator',
    slug: 'json-formatter',
    category: 'Developer Tools',
    categoryId: 'developer',
    description: 'Beautify, validate, format, and minify JSON strings with error checking.',
    badge: '100% Private',
    href: '/tools/json-formatter',
  },
  {
    name: 'Client-Side Image Compressor',
    slug: 'image-compressor',
    category: 'Image & Media',
    categoryId: 'image',
    description: 'Compress PNG, JPEG, and WebP files without uploading to external servers.',
    badge: 'Canvas Powered',
    href: '/tools/image-compressor',
  },
];
---

<BaseLayout
  title="All Developer & Web Utilities — ToolXDev"
  description="Explore the complete collection of free online tools on ToolXDev. Format JSON, analyze text, compress images, and more with zero server uploads."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Tool Directory</h1>
      <p class="mt-3 text-base text-slate-600">
        Browse our collection of lightweight, client-side digital utilities. Every tool is designed to work offline once loaded and maintain strict privacy.
      </p>
    </div>

    {/* Developer Category */}
    <div id="developer" class="mb-14 scroll-mt-20">
      <div class="flex items-center gap-3 border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900">Developer Tools</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">1 Tool</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {allTools.filter(t => t.categoryId === 'developer').map(tool => (
          <a
            href={tool.href}
            class="tool-card group rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 cursor-pointer flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-medium text-slate-500">{tool.category}</span>
                <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700 border border-blue-100">{tool.badge}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{tool.name}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{tool.description}</p>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-blue-600">
              <span>Open Tool</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Text Category */}
    <div id="text" class="mb-14 scroll-mt-20">
      <div class="flex items-center gap-3 border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900">Text & Content Utilities</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">1 Tool</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {allTools.filter(t => t.categoryId === 'text').map(tool => (
          <a
            href={tool.href}
            class="tool-card group rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 cursor-pointer flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-medium text-slate-500">{tool.category}</span>
                <span class="rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-100">{tool.badge}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{tool.name}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{tool.description}</p>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-blue-600">
              <span>Open Tool</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* Image Category */}
    <div id="image" class="mb-14 scroll-mt-20">
      <div class="flex items-center gap-3 border-b border-slate-200 pb-3 mb-6">
        <h2 class="text-xl font-bold text-slate-900">Image & Media</h2>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-600">1 Tool</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {allTools.filter(t => t.categoryId === 'image').map(tool => (
          <a
            href={tool.href}
            class="tool-card group rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 cursor-pointer flex flex-col justify-between"
          >
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-medium text-slate-500">{tool.category}</span>
                <span class="rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-semibold text-purple-700 border border-purple-100">{tool.badge}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{tool.name}</h3>
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">{tool.description}</p>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-blue-600">
              <span>Open Tool</span>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
