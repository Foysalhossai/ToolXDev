---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => data.status === 'published');
posts.sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<BaseLayout
  title="Engineering & Privacy Blog — ToolXDev"
  description="In-depth articles, tutorials, and benchmarks on web development, client-side browser performance, cryptography, and data privacy."
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Articles & Engineering Insights</h1>
      <p class="mt-3 text-base text-slate-600">
        Guides and deep-dives on web security, client-side architectures, and building modern web tools.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => {
        const slug = post.id.replace(/\.(md|mdx)$/, '');
        const dateStr = new Intl.DateTimeFormat('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        }).format(post.data.publishedDate);

        return (
          <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 transition-colors">
            <div>
              <div class="flex items-center justify-between text-xs text-slate-500 mb-3">
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-700">
                  {post.data.category}
                </span>
                <time datetime={post.data.publishedDate.toISOString()}>{dateStr}</time>
              </div>

              <h2 class="text-lg font-bold text-slate-900 hover:text-blue-600 transition-colors">
                <a href={`/blog/${slug}`}>{post.data.title}</a>
              </h2>

              <p class="mt-2 text-sm text-slate-600 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-medium text-slate-500">By {post.data.author}</span>
              <a href={`/blog/${slug}`} class="text-xs font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1">
                Read Article →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
