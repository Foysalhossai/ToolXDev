---
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredTools = [
  {
    name: 'Word Counter',
    slug: 'word-counter',
    category: 'Text & Writing',
    description: 'Instant word, character, sentence, and reading time counter. Real-time stats with zero lag.',
    badge: 'Fast & Offline',
    icon: 'text',
    href: '/tools/word-counter',
  },
  {
    name: 'JSON Formatter & Validator',
    slug: 'json-formatter',
    category: 'Developer',
    description: 'Format, validate, beautify, and minify JSON strings with error highlighting and line numbers.',
    badge: '100% Private',
    icon: 'code',
    href: '/tools/json-formatter',
  },
  {
    name: 'Image Compressor',
    slug: 'image-compressor',
    category: 'Media & Images',
    description: 'Compress PNG, JPEG, and WebP files directly in your browser without uploading to any server.',
    badge: 'Client-Side',
    icon: 'image',
    href: '/tools/image-compressor',
  },
];

const categories = [
  { name: 'Developer Tools', count: '1 Tool', href: '/tools#developer', desc: 'Formatters, validators, and code utilities' },
  { name: 'Text & Content', count: '1 Tool', href: '/tools#text', desc: 'Word count, character analysis, string tools' },
  { name: 'Image & Media', count: '1 Tool', href: '/tools#image', desc: 'Optimization, resizing, format conversion' },
  { name: 'Web & Security', count: 'Coming Soon', href: '/tools#web', desc: 'Meta tags, headers, DNS checkers' },
];
---

<BaseLayout
  title="ToolXDev — Free, Fast & Privacy-First Online Utilities"
  description="Focused web utilities for developers, creators, and students. Word Counter, JSON Formatter, Image Compressor, running 100% locally in your browser."
>
  {/* Hero Section */}
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/60 to-white px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 text-xs font-semibold text-blue-700 mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-blue-600 animate-pulse"></span>
        Zero Latency • Local Browser Processing
      </div>
      
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Everyday digital tools, <br class="hidden sm:inline" />
        <span class="text-blue-600">fast, private & completely free.</span>
      </h1>
      
      <p class="mx-auto mt-6 max-w-2xl text-base text-slate-600 sm:text-lg">
        No accounts, no paywalls, and no invasive tracking. ToolXDev runs computations on your device so your data stays confidential.
      </p>

      {/* Quick Search / Filter Bar */}
      <div class="mx-auto mt-10 max-w-xl">
        <div class="relative flex items-center">
          <input
            id="tool-search"
            type="search"
            placeholder="Search tools (e.g., json, word counter, image)..."
            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3.5 pl-11 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
          />
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Featured Tools Grid */}
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Featured Utilities</h2>
        <p class="mt-1 text-sm text-slate-500">Essential tools tested for high performance and offline reliability.</p>
      </div>
      <a href="/tools" class="inline-flex items-center gap-1.5 text-sm font-semibold text-blue-600 hover:text-blue-700">
        View all tools
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTools.map((tool) => (
        <a
          href={tool.href}
          class="tool-card group flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6 shadow-xs hover:border-blue-300 cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
                {tool.category}
              </span>
              <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 border border-emerald-200">
                {tool.badge}
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
              {tool.name}
            </h3>
            
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">
              {tool.description}
            </p>
          </div>

          <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-blue-600 group-hover:text-blue-700">
            <span>Open Tool</span>
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  {/* Category Discovery */}
  <section class="border-t border-slate-100 bg-slate-50/50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Browse by Category</h2>
        <p class="mt-2 text-sm text-slate-500">Find the right utility for your specific workflow.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {categories.map((cat) => (
          <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-xs transition hover:border-slate-300">
            <h3 class="font-bold text-slate-900 text-base">{cat.name}</h3>
            <p class="mt-1 text-xs text-slate-500">{cat.desc}</p>
            <div class="mt-4 text-xs font-semibold text-blue-600">{cat.count}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Privacy Guarantee & Value Proposition */}
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="rounded-3xl border border-blue-100 bg-blue-50/50 p-8 sm:p-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white mb-4">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Privacy by Design</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Your text, JSON, and uploaded media are never uploaded to remote servers. Everything is calculated in your browser engine.
          </p>
        </div>

        <div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white mb-4">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">Instant Execution</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            Zero network latency during tool execution. Results appear in real-time as you type or adjust compression sliders.
          </p>
        </div>

        <div>
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white mb-4">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900">No Hidden Traps</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">
            No mandatory signups, credit card fields, or artificial usage limits. Simple, honest tools that just work.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Feedback CTA */}
  <section class="border-t border-slate-200 py-12">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
      <h2 class="text-xl font-bold text-slate-900">Need a tool that isn't listed here?</h2>
      <p class="mt-2 text-sm text-slate-500">We build new utilities based on community requests. Tell us what you need.</p>
      <div class="mt-6">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-xs hover:bg-slate-50 hover:text-slate-900 cursor-pointer"
        >
          Request a New Tool
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
