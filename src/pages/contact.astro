---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Feedback — ToolXDev"
  description="Request a new tool, report a bug, or send suggestions to the ToolXDev development team."
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">Tool Request & Feedback</h1>
      <p class="mt-3 text-base text-slate-600">
        Notice a broken tool or want us to build a utility you use daily? Let us know below.
      </p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
      <form id="feedback-form" class="space-y-6">
        <div>
          <label for="feedback-type" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
            Feedback Type
          </label>
          <select
            id="feedback-type"
            required
            class="w-full rounded-xl border border-slate-300 bg-white p-3 text-sm text-slate-900 focus:border-blue-500 focus:outline-none"
          >
            <option value="request">Request a New Tool</option>
            <option value="bug">Report a Broken Tool</option>
            <option value="general">General Suggestion</option>
          </select>
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
            Your Email (Optional)
          </label>
          <input
            id="email"
            type="email"
            placeholder="you@example.com (only if you would like a reply)"
            class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
            Details & Specifications *
          </label>
          <textarea
            id="message"
            rows="5"
            required
            placeholder="Describe the tool you need or the issue you encountered..."
            class="w-full rounded-xl border border-slate-300 p-3 text-sm text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none"
          ></textarea>
        </div>

        <div id="submit-alert" class="hidden rounded-xl p-4 text-sm font-medium"></div>

        <div>
          <button
            type="submit"
            class="w-full rounded-xl bg-blue-600 py-3 px-4 text-sm font-semibold text-white shadow-xs hover:bg-blue-700 cursor-pointer transition-colors"
          >
            Submit Feedback
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('feedback-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('submit-alert');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!alertBox) return;

      alertBox.className = 'rounded-xl p-4 text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200';
      alertBox.textContent = 'Thank you for your feedback! Your request has been recorded.';
      alertBox.classList.remove('hidden');

      form.reset();
    });
  </script>
</BaseLayout>
