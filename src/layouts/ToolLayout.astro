---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  name: string;
  description: string;
  category: string;
  categoryHref: string;
  privacyNotice: string;
  howToUse: { step: string; text: string }[];
  features: string[];
  limitations: string[];
  faqs?: { q: string; a: string }[];
}

const {
  title,
  name,
  description,
  category,
  categoryHref,
  privacyNotice,
  howToUse,
  features,
  limitations,
  faqs = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <a href={categoryHref} class="hover:text-blue-600">{category}</a>
      <span>/</span>
      <span class="text-slate-900 font-medium">{name}</span>
    </nav>

    {/* Tool Header */}
    <div class="mb-8">
      <div class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 border border-blue-200 mb-3">
        {category}
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">{name}</h1>
      <p class="mt-2 text-base text-slate-600 max-w-3xl">{description}</p>
    </div>

    {/* Primary Tool Interface Surface */}
    <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-6 shadow-sm mb-12">
      <slot />
    </div>

    {/* Privacy & Execution Flow Banner */}
    <div class="rounded-xl border border-emerald-200 bg-emerald-50/60 p-4 mb-12 flex items-start gap-3">
      <div class="text-emerald-700 mt-0.5">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
      </div>
      <div class="text-sm">
        <h3 class="font-bold text-emerald-900">Privacy & Processing Guarantee</h3>
        <p class="text-emerald-800 mt-0.5 leading-relaxed">{privacyNotice}</p>
      </div>
    </div>

    {/* Explanatory Content Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-slate-200 pt-10 mb-12">
      {/* How to use */}
      <div>
        <h2 class="text-xl font-bold text-slate-900 mb-4">How to Use This Tool</h2>
        <ol class="space-y-3">
          {howToUse.map((item, index) => (
            <li class="flex items-start gap-3 text-sm text-slate-600">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-50 text-xs font-bold text-blue-600 border border-blue-100">
                {index + 1}
              </span>
              <span>
                <strong class="font-semibold text-slate-900">{item.step}:</strong> {item.text}
              </span>
            </li>
          ))}
        </ol>
      </div>

      {/* Features & Limitations */}
      <div class="space-y-6">
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">Key Capabilities</h2>
          <ul class="space-y-2 text-sm text-slate-600">
            {features.map((feat) => (
              <li class="flex items-center gap-2">
                <svg class="h-4 w-4 text-emerald-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-2">Technical Limitations</h2>
          <ul class="space-y-1.5 text-xs text-slate-500">
            {limitations.map((limit) => (
              <li class="flex items-center gap-2">
                <span class="h-1 w-1 rounded-full bg-slate-400"></span>
                <span>{limit}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    {/* FAQs Section */}
    {faqs.length > 0 && (
      <div class="border-t border-slate-200 pt-10">
        <h2 class="text-xl font-bold text-slate-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-slate-200 p-4 bg-slate-50/50">
              <h3 class="text-sm font-semibold text-slate-900">{faq.q}</h3>
              <p class="mt-1 text-sm text-slate-600 leading-relaxed">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>
