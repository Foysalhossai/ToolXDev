---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedDate: Date;
  author: string;
  category: string;
  tags?: string[];
  coverImage?: string;
}

const { title, description, publishedDate, author, category, tags = [] } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(publishedDate);
---

<BaseLayout title={`${title} — ToolXDev`} description={description}>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8 border-b border-slate-200 pb-8">
      <div class="flex items-center gap-2 mb-4">
        <a href="/blog" class="text-xs font-semibold text-blue-600 hover:text-blue-700">
          ← Back to Articles
        </a>
        <span class="text-slate-300">•</span>
        <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">
          {category}
        </span>
      </div>

      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        {title}
      </h1>

      <div class="mt-4 flex items-center gap-4 text-xs font-medium text-slate-500">
        <span>By {author}</span>
        <span>•</span>
        <time datetime={publishedDate.toISOString()}>{formattedDate}</time>
      </div>

      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-md bg-blue-50 px-2 py-0.5 text-[11px] font-medium text-blue-700 border border-blue-100">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-6">
      <slot />
    </div>

    <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-6 flex items-center justify-between">
      <div>
        <h4 class="text-sm font-bold text-slate-900">Explore Free Client-Side Tools</h4>
        <p class="text-xs text-slate-500 mt-1">Try our private web utilities with zero installations or tracking.</p>
      </div>
      <a href="/tools" class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-semibold text-white hover:bg-blue-700 cursor-pointer">
        View All Tools
      </a>
    </div>
  </article>
</BaseLayout>
