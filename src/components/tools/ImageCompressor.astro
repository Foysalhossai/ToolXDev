---
// ImageCompressor.astro
---

<div class="tool-panel rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2.5 w-2.5 rounded-full bg-purple-500 animate-pulse"></span>
      <span class="text-xs font-semibold text-slate-700 uppercase tracking-wider">Browser-Side Image Compressor</span>
    </div>
    <div class="text-xs text-slate-500 font-medium">
      Supports JPEG, PNG, WebP
    </div>
  </div>

  <div id="drop-area" class="border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-2xl p-8 sm:p-12 text-center cursor-pointer transition-colors bg-slate-50/50">
    <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp" class="hidden" />
    <svg class="mx-auto h-12 w-12 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <polyline points="21 15 16 10 5 21"></polyline>
    </svg>
    <p class="mt-4 text-sm font-semibold text-slate-800">Drag and drop your image here, or <span class="text-blue-600 underline">browse</span></p>
    <p class="mt-1 text-xs text-slate-500">Processed locally in browser memory. Max recommended file size: 25MB.</p>
  </div>

  <div id="controls-section" class="hidden mt-6 space-y-6">
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex-1">
          <label for="quality-slider" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Target Quality: <span id="quality-val" class="text-blue-600">80%</span>
          </label>
          <input
            id="quality-slider"
            type="range"
            min="10"
            max="100"
            value="80"
            class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600"
          />
        </div>
        <div class="sm:w-48">
          <label for="format-select" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            Output Format
          </label>
          <select id="format-select" class="w-full rounded-lg border border-slate-300 bg-white p-2 text-xs font-medium text-slate-800">
            <option value="image/webp">WebP (Best Compression)</option>
            <option value="image/jpeg">JPEG (Standard)</option>
            <option value="image/png">PNG</option>
          </select>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="rounded-xl border border-slate-200 p-4 bg-slate-50/50">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs font-bold text-slate-600 uppercase">Original</span>
          <span id="orig-size" class="text-xs font-semibold text-slate-800">0 KB</span>
        </div>
        <div class="aspect-video w-full flex items-center justify-center bg-slate-100 rounded-lg overflow-hidden">
          <img id="orig-img" class="max-h-full max-w-full object-contain" alt="Original preview" />
        </div>
      </div>

      <div class="rounded-xl border border-slate-200 p-4 bg-slate-50/50">
        <div class="flex justify-between items-center mb-2">
          <span class="text-xs font-bold text-slate-600 uppercase">Compressed</span>
          <div class="flex items-center gap-2">
            <span id="comp-size" class="text-xs font-semibold text-emerald-600">0 KB</span>
            <span id="savings-badge" class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800 hidden">0% saved</span>
          </div>
        </div>
        <div class="aspect-video w-full flex items-center justify-center bg-slate-100 rounded-lg overflow-hidden">
          <img id="comp-img" class="max-h-full max-w-full object-contain" alt="Compressed preview" />
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <button id="btn-reset-img" type="button" class="rounded-xl border border-slate-200 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer">
        Choose Different Image
      </button>
      <a id="btn-download-img" class="rounded-xl bg-blue-600 px-5 py-2.5 text-xs font-semibold text-white shadow-xs hover:bg-blue-700 cursor-pointer inline-flex items-center gap-2">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download Compressed Image
      </a>
    </div>
  </div>
</div>

<script>
  const dropArea = document.getElementById('drop-area');
  const fileInput = document.getElementById('image-file-input') as HTMLInputElement | null;
  const controls = document.getElementById('controls-section');
  const qualitySlider = document.getElementById('quality-slider') as HTMLInputElement | null;
  const qualityVal = document.getElementById('quality-val');
  const formatSelect = document.getElementById('format-select') as HTMLSelectElement | null;
  const origImg = document.getElementById('orig-img') as HTMLImageElement | null;
  const compImg = document.getElementById('comp-img') as HTMLImageElement | null;
  const origSize = document.getElementById('orig-size');
  const compSize = document.getElementById('comp-size');
  const savingsBadge = document.getElementById('savings-badge');
  const btnDownload = document.getElementById('btn-download-img') as HTMLAnchorElement | null;
  const btnReset = document.getElementById('btn-reset-img');

  let currentRawImage: HTMLImageElement | null = null;
  let originalFileSizeBytes = 0;
  let originalFileName = 'compressed-image';

  function formatBytes(bytes: number) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(2) + ' MB';
  }

  function compressImage() {
    if (!currentRawImage) return;
    const canvas = document.createElement('canvas');
    canvas.width = currentRawImage.naturalWidth;
    canvas.height = currentRawImage.naturalHeight;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.drawImage(currentRawImage, 0, 0);

    const quality = qualitySlider ? parseFloat(qualitySlider.value) / 100 : 0.8;
    const format = formatSelect ? formatSelect.value : 'image/webp';

    canvas.toBlob((blob) => {
      if (!blob || !compImg || !compSize || !btnDownload) return;
      const url = URL.createObjectURL(blob);
      compImg.src = url;
      compSize.textContent = formatBytes(blob.size);

      const ext = format === 'image/jpeg' ? '.jpg' : format === 'image/png' ? '.png' : '.webp';
      btnDownload.href = url;
      btnDownload.download = `toolxdev-${originalFileName.replace(/\.[^/.]+$/, '')}${ext}`;

      if (savingsBadge) {
        if (blob.size < originalFileSizeBytes) {
          const savedPct = Math.round(((originalFileSizeBytes - blob.size) / originalFileSizeBytes) * 100);
          savingsBadge.textContent = `${savedPct}% saved`;
          savingsBadge.className = 'rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-bold text-emerald-800';
          savingsBadge.classList.remove('hidden');
        } else {
          savingsBadge.textContent = 'Larger than original';
          savingsBadge.className = 'rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-800';
          savingsBadge.classList.remove('hidden');
        }
      }
    }, format, quality);
  }

  function handleFile(file: File) {
    if (!file || !file.type.startsWith('image/')) return;
    originalFileSizeBytes = file.size;
    originalFileName = file.name;
    if (origSize) origSize.textContent = formatBytes(file.size);

    const reader = new FileReader();
    reader.onload = (e) => {
      const src = e.target?.result as string;
      const img = new Image();
      img.onload = () => {
        currentRawImage = img;
        if (origImg) origImg.src = src;
        dropArea?.classList.add('hidden');
        controls?.classList.remove('hidden');
        compressImage();
      };
      img.src = src;
    };
    reader.readAsDataURL(file);
  }

  dropArea?.addEventListener('click', () => fileInput?.click());
  dropArea?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropArea.classList.add('border-blue-500', 'bg-blue-50/50');
  });
  dropArea?.addEventListener('dragleave', () => {
    dropArea.classList.remove('border-blue-500', 'bg-blue-50/50');
  });
  dropArea?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropArea.classList.remove('border-blue-500', 'bg-blue-50/50');
    if (e.dataTransfer?.files.length) {
      handleFile(e.dataTransfer.files[0]);
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.length) {
      handleFile(fileInput.files[0]);
    }
  });

  qualitySlider?.addEventListener('input', () => {
    if (qualityVal && qualitySlider) {
      qualityVal.textContent = `${qualitySlider.value}%`;
    }
    compressImage();
  });

  formatSelect?.addEventListener('change', compressImage);

  btnReset?.addEventListener('click', () => {
    currentRawImage = null;
    if (fileInput) fileInput.value = '';
    controls?.classList.add('hidden');
    dropArea?.classList.remove('hidden');
  });
</script>
