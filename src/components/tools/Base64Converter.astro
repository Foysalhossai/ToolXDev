---
// Base64Converter.astro
---

<div class="tool-panel rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2.5 w-2.5 rounded-full bg-indigo-500 animate-pulse"></span>
      <span class="text-xs font-semibold text-slate-700 uppercase tracking-wider">Client-Side Base64 Encoder / Decoder</span>
    </div>
    <div class="flex gap-2">
      <button id="btn-mode-encode" type="button" class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-medium text-white cursor-pointer transition-colors">
        Encode
      </button>
      <button id="btn-mode-decode" type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors">
        Decode
      </button>
      <button id="btn-clear-b64" type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 cursor-pointer transition-colors">
        Clear
      </button>
    </div>
  </div>

  <div id="b64-status" class="hidden mb-4 rounded-xl p-3 text-xs font-medium transition-all"></div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div>
      <label id="input-label" for="b64-input" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
        Plain Text Input
      </label>
      <textarea
        id="b64-input"
        rows="10"
        placeholder="Type or paste text to encode..."
        class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none"
      ></textarea>
    </div>

    <div>
      <div class="flex justify-between items-center mb-2">
        <label id="output-label" for="b64-output" class="text-xs font-bold text-slate-700 uppercase tracking-wider">
          Base64 Output
        </label>
        <button id="btn-copy-b64" type="button" class="text-xs font-semibold text-blue-600 hover:text-blue-700 cursor-pointer">
          Copy Output
        </button>
      </div>
      <textarea
        id="b64-output"
        rows="10"
        readonly
        placeholder="Output will appear here..."
        class="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:outline-none"
      ></textarea>
    </div>
  </div>
</div>

<script>
  const b64Input = document.getElementById('b64-input') as HTMLTextAreaElement | null;
  const b64Output = document.getElementById('b64-output') as HTMLTextAreaElement | null;
  const inputLabel = document.getElementById('input-label');
  const outputLabel = document.getElementById('output-label');
  const statusBox = document.getElementById('b64-status');

  const btnEncode = document.getElementById('btn-mode-encode');
  const btnDecode = document.getElementById('btn-mode-decode');
  const btnClear = document.getElementById('btn-clear-b64');
  const btnCopy = document.getElementById('btn-copy-b64');

  let mode: 'encode' | 'decode' = 'encode';

  function updateMode(newMode: 'encode' | 'decode') {
    mode = newMode;
    if (mode === 'encode') {
      btnEncode?.classList.remove('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      btnEncode?.classList.add('bg-blue-600', 'text-white');
      btnDecode?.classList.remove('bg-blue-600', 'text-white');
      btnDecode?.classList.add('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      if (inputLabel) inputLabel.textContent = 'Plain Text Input';
      if (outputLabel) outputLabel.textContent = 'Base64 Encoded Output';
      if (b64Input) b64Input.placeholder = 'Type or paste plain text to encode...';
    } else {
      btnDecode?.classList.remove('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      btnDecode?.classList.add('bg-blue-600', 'text-white');
      btnEncode?.classList.remove('bg-blue-600', 'text-white');
      btnEncode?.classList.add('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      if (inputLabel) inputLabel.textContent = 'Base64 Encoded Input';
      if (outputLabel) outputLabel.textContent = 'Plain Text Decoded Output';
      if (b64Input) b64Input.placeholder = 'Paste valid Base64 string to decode...';
    }
    process();
  }

  function process() {
    if (!b64Input || !b64Output) return;
    const val = b64Input.value;
    if (!val) {
      b64Output.value = '';
      if (statusBox) statusBox.classList.add('hidden');
      return;
    }

    try {
      if (mode === 'encode') {
        // UTF-8 safe encode
        const encoded = btoa(encodeURIComponent(val).replace(/%([0-9A-F]{2})/g, (_, p1) => {
          return String.fromCharCode(parseInt(p1, 16));
        }));
        b64Output.value = encoded;
        if (statusBox) statusBox.classList.add('hidden');
      } else {
        // UTF-8 safe decode
        const decoded = decodeURIComponent(Array.prototype.map.call(atob(val.trim()), (c: string) => {
          return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
        }).join(''));
        b64Output.value = decoded;
        if (statusBox) statusBox.classList.add('hidden');
      }
    } catch (e: any) {
      b64Output.value = '';
      if (statusBox) {
        statusBox.className = 'mb-4 rounded-xl p-3 text-xs font-medium bg-red-50 text-red-700 border border-red-200';
        statusBox.textContent = `Error: ${e.message || 'Invalid Base64 input'}`;
      }
    }
  }

  b64Input?.addEventListener('input', process);
  btnEncode?.addEventListener('click', () => updateMode('encode'));
  btnDecode?.addEventListener('click', () => updateMode('decode'));

  btnClear?.addEventListener('click', () => {
    if (b64Input) b64Input.value = '';
    if (b64Output) b64Output.value = '';
    if (statusBox) statusBox.classList.add('hidden');
  });

  btnCopy?.addEventListener('click', async () => {
    if (!b64Output || !b64Output.value) return;
    await navigator.clipboard.writeText(b64Output.value);
    const orig = btnCopy.textContent;
    btnCopy.textContent = 'Copied!';
    setTimeout(() => {
      btnCopy.textContent = orig;
    }, 1500);
  });
</script>
