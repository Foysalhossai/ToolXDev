---
// UrlSlugConverter.astro
---

<div class="tool-panel rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-100 pb-4 mb-6">
    <div class="flex items-center gap-2">
      <span class="inline-flex h-2.5 w-2.5 rounded-full bg-cyan-500 animate-pulse"></span>
      <span class="text-xs font-semibold text-slate-700 uppercase tracking-wider">URL Encoder & SEO Slug Generator</span>
    </div>
    <div class="flex gap-2">
      <button id="btn-mode-slug" type="button" class="rounded-lg bg-blue-600 px-3 py-1.5 text-xs font-medium text-white cursor-pointer transition-colors">
        SEO Slug
      </button>
      <button id="btn-mode-encode" type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors">
        URL Encode
      </button>
      <button id="btn-mode-decode" type="button" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-100 cursor-pointer transition-colors">
        URL Decode
      </button>
    </div>
  </div>

  <div class="space-y-6">
    <div>
      <label for="url-input" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
        Source Input
      </label>
      <textarea
        id="url-input"
        rows="4"
        placeholder="Type any article title, parameter, or URL here..."
        class="w-full rounded-xl border border-slate-300 p-4 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-blue-500 focus:outline-none"
      ></textarea>
    </div>

    <div>
      <div class="flex justify-between items-center mb-2">
        <label for="url-output" class="text-xs font-bold text-slate-700 uppercase tracking-wider">
          Converted Result
        </label>
        <button id="btn-copy-url" type="button" class="text-xs font-semibold text-blue-600 hover:text-blue-700 cursor-pointer">
          Copy Result
        </button>
      </div>
      <textarea
        id="url-output"
        rows="4"
        readonly
        placeholder="Output will appear here..."
        class="w-full rounded-xl border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:outline-none"
      ></textarea>
    </div>
  </div>
</div>

<script>
  const urlInput = document.getElementById('url-input') as HTMLTextAreaElement | null;
  const urlOutput = document.getElementById('url-output') as HTMLTextAreaElement | null;

  const btnSlug = document.getElementById('btn-mode-slug');
  const btnEncode = document.getElementById('btn-mode-encode');
  const btnDecode = document.getElementById('btn-mode-decode');
  const btnCopy = document.getElementById('btn-copy-url');

  let activeMode: 'slug' | 'encode' | 'decode' = 'slug';

  function slugify(text: string): string {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .normalize('NFD') // separate accent marks
      .replace(/[\u0300-\u036f]/g, '') // remove accent marks
      .replace(/[^a-z0-9 -]/g, '') // remove invalid chars
      .replace(/\s+/g, '-') // collapse whitespace and replace by -
      .replace(/-+/g, '-'); // collapse dashes
  }

  function setMode(mode: 'slug' | 'encode' | 'decode') {
    activeMode = mode;
    [btnSlug, btnEncode, btnDecode].forEach((btn) => {
      btn?.classList.remove('bg-blue-600', 'text-white');
      btn?.classList.add('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
    });

    if (mode === 'slug') {
      btnSlug?.classList.remove('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      btnSlug?.classList.add('bg-blue-600', 'text-white');
    } else if (mode === 'encode') {
      btnEncode?.classList.remove('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      btnEncode?.classList.add('bg-blue-600', 'text-white');
    } else {
      btnDecode?.classList.remove('border', 'border-slate-200', 'bg-slate-50', 'text-slate-700');
      btnDecode?.classList.add('bg-blue-600', 'text-white');
    }

    process();
  }

  function process() {
    if (!urlInput || !urlOutput) return;
    const val = urlInput.value;
    if (!val) {
      urlOutput.value = '';
      return;
    }

    try {
      if (activeMode === 'slug') {
        urlOutput.value = slugify(val);
      } else if (activeMode === 'encode') {
        urlOutput.value = encodeURIComponent(val);
      } else {
        urlOutput.value = decodeURIComponent(val);
      }
    } catch (e: any) {
      urlOutput.value = `Error: ${e.message || 'Invalid URI format'}`;
    }
  }

  urlInput?.addEventListener('input', process);
  btnSlug?.addEventListener('click', () => setMode('slug'));
  btnEncode?.addEventListener('click', () => setMode('encode'));
  btnDecode?.addEventListener('click', () => setMode('decode'));

  btnCopy?.addEventListener('click', async () => {
    if (!urlOutput || !urlOutput.value) return;
    await navigator.clipboard.writeText(urlOutput.value);
    const orig = btnCopy.textContent;
    btnCopy.textContent = 'Copied!';
    setTimeout(() => {
      btnCopy.textContent = orig;
    }, 1500);
  });
</script>
